{
  "name": "@houetor/connect-mcp",
  "version": "2.3.0",
  "description": "Miroir lab du serveur MCP HOUETOR (app/mcp) — pilote houetor-connect (WordPress) en JSON-RPC 2.0 + SSE, tools portables dans app/mcp/",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "houetor-mcp": "dist/index.cjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:integration": "node scripts/integration-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
